            "title": "Conversions"
          },
          "tzdb_version": {
            "type": "string",
            "title": "Tzdb Version"
          },
          "tzdb_latest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tzdb Latest"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
