{
  "openapi": "3.1.0",
  "info": {
    "title": "Akashi Live Facts",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/version": {
      "get": {
        "summary": "Version",
        "operationId": "version_v1_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Version V1 Version Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/time": {
      "post": {
        "summary": "Time",
        "operationId": "time_v1_time_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_TimeResult_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agreement": {
        "type": "string",
        "enum": [
          "agree",
          "minor_diff",
          "conflict",
          "single_source"
        ],
        "title": "Agreement"
      },
      "CacheState": {
        "type": "string",
        "enum": [
          "hit",
          "miss",
          "stale"
        ],
        "title": "CacheState"
      },
      "Envelope_TimeResult_": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "deadline_ms": {
            "type": "integer",
            "title": "Deadline Ms"
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          },
          "unavailable": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unavailable"
          },
          "summary": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Summary"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/TimeResult"
            },
            "type": "array",
            "title": "Results"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "type": "array",
            "title": "Sources"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "service",
          "operation",
          "version",
          "status",
          "as_of",
          "deadline_ms",
          "elapsed_ms"
        ],
        "title": "Envelope[TimeResult]"
      },
      "Freshness": {
        "type": "string",
        "enum": [
          "fresh",
          "lagging",
          "stale",
          "unknown"
        ],
        "title": "Freshness"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Provenance": {
        "properties": {
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "age_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Seconds"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness",
            "default": "unknown"
          },
          "agreement": {
            "$ref": "#/components/schemas/Agreement",
            "default": "single_source"
          },
          "spread_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spread Pct"
          },
          "licence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Licence"
          },
          "attribution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attribution"
          }
        },
        "type": "object",
        "title": "Provenance"
      },
      "ResponseStatus": {
        "type": "string",
        "enum": [
          "complete",
          "partial"
        ],
        "title": "ResponseStatus"
      },
      "SourceRef": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/SourceStatus"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "licence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Licence"
          },
          "attribution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attribution"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "fetched_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fetched At"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "cache": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CacheState"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "SourceRef"
      },
      "SourceStatus": {
        "type": "string",
        "enum": [
          "ok",
          "not_found",
          "unavailable",
          "rate_limited",
          "skipped_budget",
          "not_applicable"
        ],
        "title": "SourceStatus"
      },
      "TimeRequest": {
        "properties": {
          "zone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone",
            "description": "IANA zone, e.g. Africa/Casablanca"
          },
          "place": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Place",
            "description": "City or country name"
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Country",
            "description": "ISO 3166-1 alpha-2 hint"
          },
          "at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "At",
            "description": "Instant to evaluate (ISO 8601; default now)"
          },
          "convert_to": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Convert To"
          }
        },
        "type": "object",
        "title": "TimeRequest"
      },
      "TimeResult": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "time",
            "title": "Kind",
            "default": "time"
          },
          "zone": {
            "type": "string",
            "title": "Zone"
          },
          "matched": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched"
          },
          "at_utc": {
            "type": "string",
            "title": "At Utc"
          },
          "local_time": {
            "type": "string",
            "title": "Local Time"
          },
          "utc_offset": {
            "type": "string",
            "title": "Utc Offset"
          },
          "abbreviation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abbreviation"
          },
          "is_dst": {
            "type": "boolean",
            "title": "Is Dst"
          },
          "next_transition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Transition"
              },
              {
                "type": "null"
              }
            ]
          },
          "conversions": {
            "items": {
              "$ref": "#/components/schemas/ZoneTime"
            },
            "type": "array",
            "title": "Conversions"
          },
          "tzdb_version": {
            "type": "string",
            "title": "Tzdb Version"
          },
          "tzdb_latest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tzdb Latest"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "zone",
          "at_utc",
          "local_time",
          "utc_offset",
          "is_dst",
          "tzdb_version",
          "provenance"
        ],
        "title": "TimeResult"
      },
      "Transition": {
        "properties": {
          "at": {
            "type": "string",
            "title": "At"
          },
          "offset_before": {
            "type": "string",
            "title": "Offset Before"
          },
          "offset_after": {
            "type": "string",
            "title": "Offset After"
          }
        },
        "type": "object",
        "required": [
          "at",
          "offset_before",
          "offset_after"
        ],
        "title": "Transition"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ZoneTime": {
        "properties": {
          "zone": {
            "type": "string",
            "title": "Zone"
          },
          "local_time": {
            "type": "string",
            "title": "Local Time"
          },
          "utc_offset": {
            "type": "string",
            "title": "Utc Offset"
          },
          "abbreviation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abbreviation"
          },
          "is_dst": {
            "type": "boolean",
            "title": "Is Dst"
          }
        },
        "type": "object",
        "required": [
          "zone",
          "local_time",
          "utc_offset",
          "is_dst"
        ],
        "title": "ZoneTime"
      }
    }
  }
}
