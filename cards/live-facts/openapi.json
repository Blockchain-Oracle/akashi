            "title": "Local Time"
          },
          "utc_offset": {
            "type": "string",
            "title": "Utc Offset"
          },
          "abbreviation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abbreviation"
          },
          "is_dst": {
            "type": "boolean",
            "title": "Is Dst"
          }
        },
        "type": "object",
        "required": [
