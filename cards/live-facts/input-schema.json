{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "properties": {
        "zone": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "IANA zone, e.g. Africa/Casablanca"
        },
        "place": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "City or country name"
        },
        "country": {
          "anyOf": [
            {
              "maxLength": 2,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 3166-1 alpha-2 hint"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Instant to evaluate (ISO 8601; default now)"
        },
        "convert_to": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        }
      },
      "type": "object"
    },
    {
      "properties": {
        "country": {
          "description": "ISO 3166-1 alpha-2",
          "maxLength": 2,
          "minLength": 2,
          "type": "string"
        },
        "year": {
          "maximum": 2100,
          "minimum": 1900,
          "type": "integer"
        },
        "subdivision": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "e.g. BY (Bavaria), CA (California)"
        },
        "calendar": {
          "description": "'public' or a market: NYSE, ECB, LSE\u2026",
          "maxLength": 10,
          "type": "string"
        }
      },
      "required": [
        "country",
        "year"
      ],
      "type": "object"
    },
    {
      "properties": {
        "country": {
          "description": "ISO 3166-1 alpha-2",
          "maxLength": 2,
          "minLength": 2,
          "type": "string"
        },
        "subdivision": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "calendar": {
          "maxLength": 10,
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "add_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": -3650,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "country",
        "start"
      ],
      "type": "object"
    },
    {
      "properties": {
        "base": {
          "description": "ISO 4217, e.g. USD",
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        },
        "quotes": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        },
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Historical date (default: latest)"
        }
      },
      "required": [
        "base",
        "quotes"
      ],
      "type": "object"
    },
    {
      "properties": {
        "lat": {
          "anyOf": [
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "place": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    {
      "properties": {
        "subject": {
          "description": "Wikidata QID or a name, e.g. Q30 / United States",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "property": {
          "description": "Wikidata PID or an alias, e.g. P35 / head of state",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "subject",
        "property"
      ],
      "type": "object"
    },
    {
      "properties": {
        "query": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "since_hours": {
          "maximum": 72,
          "minimum": 1,
          "type": "integer"
        },
        "country": {
          "anyOf": [
            {
              "maxLength": 2,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 3166-1 alpha-2 mentioned"
        },
        "limit": {
          "maximum": 25,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    {
      "properties": {
        "query": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Words in the title/team"
        },
        "companies": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "salary_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only postings that state a salary at or above"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 3,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "posted_within_days": {
          "maximum": 90,
          "minimum": 1,
          "type": "integer"
        },
        "limit": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    }
  ]
}
