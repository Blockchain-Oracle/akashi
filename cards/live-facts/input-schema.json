{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "properties": {
        "zone": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "IANA zone, e.g. Africa/Casablanca"
        },
        "place": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "City or country name"
        },
        "country": {
          "anyOf": [
            {
              "maxLength": 2,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 3166-1 alpha-2 hint"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Instant to evaluate (ISO 8601; default now)"
        },
        "convert_to": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        }
      },
      "type": "object"
    }
  ]
}
