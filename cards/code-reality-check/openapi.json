                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/check": {
      "post": {
        "summary": "Check a code snippet",
        "description": "Parses a snippet (python, typescript, javascript, go, rust, up to 49,152 bytes) and checks every import and call it makes: that each package exists and each symbol exists in it, up to 60 distinct references. Returns one diagnostic per reference with its line and column, and optional version pins via `versions`. Hard stop 7 s.",
        "operationId": "check",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_Diagnostic_"
                }
              }
            }
          },
          "400": {
            "description": "Body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Body over the size limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Valid JSON that fails validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CacheState": {
        "type": "string",
        "enum": [
          "hit",
          "miss",
          "stale"
        ],
        "title": "CacheState"
      },
      "CheckLanguage": {
        "type": "string",
        "enum": [
          "python",
          "typescript",
          "javascript",
          "go",
          "rust"
        ],
        "title": "CheckLanguage"
      },
      "CheckRequest": {
        "properties": {
          "language": {
            "$ref": "#/components/schemas/CheckLanguage"
          },
          "code": {
            "type": "string",
            "maxLength": 49152,
            "minLength": 1,
            "title": "Code"
          },
          "versions": {
            "patternProperties": {
              "^[!-~]+$": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[!-~]+$"
              }
            },
            "propertyNames": {
              "maxLength": 214,
              "minLength": 1
            },
            "type": "object",
            "maxProperties": 50,
            "title": "Versions"
          }
        },
        "type": "object",
        "required": [
          "language",
          "code"
        ],
        "title": "CheckRequest",
        "examples": [
          {
            "code": "import reqeusts\n\nresponse = reqeusts.get(\"https://example.com\", timeout=5)\n",
            "language": "python"
          }
        ]
      },
      "Diagnostic": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "diagnostic",
            "title": "Kind",
            "default": "diagnostic"
          },
          "line": {
            "type": "integer",
            "title": "Line"
          },
          "column": {
            "type": "integer",
            "title": "Column"
          },
          "end_line": {
            "type": "integer",
            "title": "End Line"
          },
          "end_column": {
            "type": "integer",
            "title": "End Column"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "ref_kind": {
            "type": "string",
            "enum": [
              "import",
              "call",
              "attribute"
            ],
            "title": "Ref Kind"
          },
          "package": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Package"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "verdict": {
            "$ref": "#/components/schemas/DiagnosticVerdict"
          },
          "signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signature"
          },
          "fix_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fix Hint"
          },
          "did_you_mean": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Did You Mean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "line",
          "column",
          "end_line",
          "end_column",
          "text",
          "ref_kind",
          "verdict"
        ],
        "title": "Diagnostic"
      },
      "DiagnosticVerdict": {
        "type": "string",
        "enum": [
          "ok",
          "nonexistent_package",
          "placeholder",
          "likely_typo",
          "suspicious_new",
          "nonexistent_symbol",
          "deprecated",
          "unknown"
        ],
        "title": "DiagnosticVerdict"
      },
      "Ecosystem": {
        "type": "string",
        "enum": [
          "npm",
          "pypi",
          "cargo",
          "go",
          "maven",
          "rubygems",
          "packagist",
          "nuget"
        ],
        "title": "Ecosystem"
      },
      "Envelope_Diagnostic_": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
