{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "properties": {
        "citations": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "properties": {
                  "raw": {
                    "anyOf": [
                      {
                        "maxLength": 2000,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "doi": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "arxiv": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "pmid": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "authors": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 30,
                    "type": "array"
                  },
                  "year": {
                    "anyOf": [
                      {
                        "maximum": 2100,
                        "minimum": 1500,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "venue": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "volume": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "pages": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "legal_cite": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "type": "object"
              }
            ]
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        },
        "options": {
          "properties": {
            "check_urls": {
              "type": "boolean"
            },
            "retraction": {
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "citations"
      ],
      "type": "object"
    }
  ]
}
