{
  "name": "@akashi/ts-introspect",
  "private": true,
  "version": "1.0.0",
  "description": "Exact .d.ts symbol answers for npm packages (TypeScript Compiler API, pinned to 6.0.3).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24"
  }
}
