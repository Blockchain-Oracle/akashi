# The x402 gateway (services/gateway). Copy to .env.local for `pnpm dev`; never commit real values.

# Where the tool-router backend listens (free reads, and paid runs when there is no relay)
AKASHI_API_URL=http://localhost:8000
# Base Sepolia address that receives every payment
AKASHI_PAY_TO=
# The public URL of this gateway, used in the x402 `resource` field
AKASHI_PUBLIC_URL=http://localhost:8080

# pocket-ap's listener. When set, paid runs travel as Pocket relays; when unset, runs go direct and say so.
POCKET_AP_URL=
# Call the backend directly when the relay layer is down (the receipt then says `via: direct`)
AKASHI_DIRECT_FALLBACK=true

X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
# Comma-separated browser origins allowed to call the gateway, or * for any
AKASHI_CORS_ORIGINS=*

# A Base Sepolia test wallet with test USDC that pays for runs made through the remote MCP server (/mcp)
DEMO_WALLET_PRIVATE_KEY=
