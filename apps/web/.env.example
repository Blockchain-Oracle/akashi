# The web app (apps/web). Copy to .env.local; never commit real values. Only NEXT_PUBLIC_* reach the browser.

NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_DOCS_URL=http://localhost:3200
# The public gateway that browsers pay through
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional: WalletConnect (without it, browser-extension wallets only) and a Base Sepolia RPC
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Server only
AKASHI_API_URL=http://localhost:8000
AKASHI_GATEWAY_URL=http://localhost:8080
# Chat history and rate limits (optional in development: memory is used without them)
REDIS_URL=
CHAT_REDIS_URL=
# Signs the session cookie
SIWE_SECRET=
IP_HASH_SALT=
# A Base Sepolia test wallet with test USDC that pays for demo-credit runs in the chat
DEMO_WALLET_PRIVATE_KEY=

# The chat's model: set AI_MODEL ("creator/model") and one key. GROQ_API_KEY alone also works.
AI_MODEL=
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
